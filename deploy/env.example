# Copy to deploy/.env (never commit). Generate secrets yourself.
# Local: scripts/local.sh writes deploy/.env.local instead.

N4X_NEO4J_PASSWORD=change-me
N4X_PUBLIC_ORIGIN=http://127.0.0.1:7744
N4X_SECRETS_MASTER_KEY=replace-with-a-long-random-string
N4X_FILE_DELIVERY_SIGNING_KEY=replace-with-at-least-32-characters
# Official index published with each v* GitHub release. Empty uses bundled only.
# https://github.com/P451M/n4x-core/releases/latest/download/release-index.json
N4X_SYSTEM_RELEASE_INDEX=
